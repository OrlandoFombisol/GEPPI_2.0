# Mismas rutas que Supabase, para que supabase-js funcione igual que antes
:80 {
	encode gzip

	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /storage/v1/* {
		request_body {
			max_size 50MB
		}
		reverse_proxy storage:5000
	}

	# Pantallas de GEEPI (aplicación de una sola página)
	# Los archivos con huella en el nombre no cambian nunca; la página sí: siempre se pide de nuevo
	@huella path /assets/*
	header @huella Cache-Control "public, max-age=31536000, immutable"
	@pagina not path /assets/*
	header @pagina Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
